<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Diggem | Coming Soon</title>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      font-family: 'Bebas Neue', sans-serif;
      background: #1a1a1a;
      color: #fff;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      text-align: center;
      overflow: hidden;
    }
    .container {
      padding: 20px;
      max-width: 600px;
    }
    .logo-primary {
      max-width: 200px;
      margin-bottom: 10px;
      animation: neon-glow 2s ease-in-out infinite;
    }
    .logo-secondary {
      max-width: 100px;
      margin: 5px;
      animation: neon-glow 2s ease-in-out infinite;
    }
    .logo-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      margin-bottom: 20px;
    }
    h1 {
      font-size: 3.5em;
      color: #e63946;
      text-transform: uppercase;
      letter-spacing: 2px;
    }
    p {
      font-family: 'Montserrat', sans-serif;
      font-size: 1.5em;
      margin: 20px 0;
      color: #fff;
    }
    .signup-form {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin: 20px 0;
    }
    input {
      padding: 10px;
      background: #333;
      border: none;
      color: #fff;
      border-radius: 5px;
      font-family: 'Montserrat', sans-serif;
      font-size: 1em;
    }
    button {
      background: #e63946;
      color: #fff;
      padding: 10px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-size: 1.2em;
      transition: background 0.3s;
    }
    button:hover {
      background: #f48c06;
    }
    .social-links {
      margin-top: 20px;
    }
    .social-links a {
      color: #fff;
      margin: 0 15px;
      font-family: 'Montserrat', sans-serif;
      font-size: 1.2em;
      text-decoration: none;
      transition: color 0.3s;
    }
    .social-links a:hover {
      color: #e63946;
    }
    @keyframes neon-glow {
      0% { filter: drop-shadow(0 0 10px #e63946); }
      50% { filter: drop-shadow(0 0 20px #e63946); }
      100% { filter: drop-shadow(0 0 10px #e63946); }
    }
  </style>
</head>
<body>
  <div class="container">
    <img src="TheDiggemClothingLogo001.png" class="logo-primary" alt="The Diggem Clothing Logo">
    <div class="logo-grid">
      <img src="WBSTheDiggemClothingLogo001.png" class="logo-secondary" alt="WBS The Diggem Clothing Logo">
      <img src="WBSTheDiggemGamingLogo001.png" class="logo-secondary" alt="WBS The Diggem Gaming Logo">
      <img src="WBSTheDiggemyoutubeLogo001.png" class="logo-secondary" alt="WBS The Diggem YouTube Logo">
      <img src="WBSArtifactedThreadsLogo001.png" class="logo-secondary" alt="WBS Artifacted Threads Logo">
    </div>
    <h1>The Diggem</h1>
    <p>Unleash Your Edge. Coming Soon! 🔥</p>
    <form class="signup-form" action="https://your-mailchimp-form-url" method="post">
      <input type="email" placeholder="Enter your email for updates" required>
      <button type="submit">Join the Rebellion</button>
    </form>
    <div class="social-links">
      <a href="https://www.youtube.com/@TheDiggemOfficial" target="_blank">YouTube Main</a>
      <a href="https://www.youtube.com/@TheDiggemGaming" target="_blank">YouTube Gaming</a>
      <a href="https://www.amazon.com/s?rh=n%3A7141123011%2Cp_4%3AThe%2BDiggem%2BClothing&ref=bl_sl_s_ap_web_7141123011" target="_blank">Shop Merch</a>
      <a href="https://instagram.com/thediggemclothing" target="_blank">Instagram</a>
      <a href="https://your-podcast-link" target="_blank">Podcast</a>
    </div>
  </div>
</body>
</html>
