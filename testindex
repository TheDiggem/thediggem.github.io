<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DIGGEM | Streetwear Gaming Lifestyle</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>
    <script src="https://unpkg.com/feather-icons"></script>
    <script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.globe.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;700&display=swap');
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #0a0a0a;
            color: #f5f5f5;
        }
        .diggem-font {
            font-family: 'Bebas Neue', sans-serif;
            letter-spacing: 2px;
        }
        .glow {
            text-shadow: 0 0 10px #ff00ff, 0 0 20px #00ffff;
        }
        .bg-grid {
            background-image: 
                linear-gradient(rgba(255, 0, 255, 0.1) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 0, 255, 0.1) 1px, transparent 1px);
            background-size: 40px 40px;
        }
    </style>
</head>
<body class="min-h-screen">
    <div id="vanta-bg" class="fixed inset-0 -z-10 opacity-20"></div>
    
    <!-- Navigation -->
    <nav class="bg-black bg-opacity-80 backdrop-blur-md sticky top-0 z-50 border-b border-purple-500">
        <div class="container mx-auto px-4 py-3">
            <div class="flex justify-between items-center">
                <a href="#" class="diggem-font text-2xl text-white hover:text-purple-400 transition">DIGGEM</a>
                <div class="hidden md:flex space-x-8">
                    <a href="#" class="text-white hover:text-cyan-400 transition">HOME</a>
                    <a href="#shop" class="text-white hover:text-cyan-400 transition">SHOP</a>
                    <a href="#gaming" class="text-white hover:text-cyan-400 transition">GAMING</a>
                    <a href="#blog" class="text-white hover:text-cyan-400 transition">BLOG</a>
                    <a href="#about" class="text-white hover:text-cyan-400 transition">ABOUT</a>
                </div>
                <button class="md:hidden text-white">
                    <i data-feather="menu"></i>
                </button>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="min-h-screen flex items-center justify-center bg-grid">
        <div class="container mx-auto px-4 text-center" data-aos="fade-up">
            <h1 class="diggem-font text-6xl md:text-8xl mb-4 text-white glow">DIGGEM</h1>
            <p class="text-xl md:text-2xl mb-8 text-gray-300 max-w-2xl mx-auto">
                Where streetwear meets gaming culture. Wear the vibe, live the grind.
            </p>
            <div class="flex justify-center space-x-4">
                <a href="#shop" class="bg-purple-600 hover:bg-cyan-600 text-white px-6 py-3 rounded-full font-bold transition transform hover:scale-105">
                    SHOP NOW
                </a>
                <a href="#gaming" class="bg-transparent border-2 border-white hover:border-cyan-400 text-white px-6 py-3 rounded-full font-bold transition transform hover:scale-105">
                    WATCH VIDS
                </a>
            </div>
        </div>
    </section>

    <!-- Shop Section -->
    <section id="shop" class="py-20 bg-black bg-opacity-90">
        <div class="container mx-auto px-4">
            <h2 class="diggem-font text-4xl mb-12 text-center text-white" data-aos="fade-up">DIGGEM MERCH</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Product 1 -->
                <div class="bg-gray-900 rounded-lg overflow-hidden shadow-lg hover:shadow-purple-500/30 transition" data-aos="fade-up" data-aos-delay="100">
                    <img src="http://static.photos/black/640x360/1" alt="Diggem Black Tee" class="w-full h-64 object-cover">
                    <div class="p-6">
                        <h3 class="diggem-font text-2xl text-white mb-2">DIGGEM BLACK TEE</h3>
                        <p class="text-gray-400 mb-4">Premium cotton streetwear essential</p>
                        <div class="flex justify-between items-center">
                            <span class="text-purple-400 font-bold text-xl">$29.99</span>
                            <a href="#" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-full text-sm font-bold transition">
                                BUY ON AMAZON
                            </a>
                        </div>
                    </div>
                </div>
                
                <!-- Product 2 -->
                <div class="bg-gray-900 rounded-lg overflow-hidden shadow-lg hover:shadow-cyan-500/30 transition" data-aos="fade-up" data-aos-delay="200">
                    <img src="http://static.photos/black/640x360/2" alt="Diggem Logo Hoodie" class="w-full h-64 object-cover">
                    <div class="p-6">
                        <h3 class="diggem-font text-2xl text-white mb-2">LOGO HOODIE</h3>
                        <p class="text-gray-400 mb-4">Oversized fit with bold branding</p>
                        <div class="flex justify-between items-center">
                            <span class="text-cyan-400 font-bold text-xl">$59.99</span>
                            <a href="#" class="bg-cyan-600 hover:bg-cyan-700 text-white px-4 py-2 rounded-full text-sm font-bold transition">
                                BUY ON AMAZON
                            </a>
                        </div>
                    </div>
                </div>
                
                <!-- Product 3 -->
                <div class="bg-gray-900 rounded-lg overflow-hidden shadow-lg hover:shadow-purple-500/30 transition" data-aos="fade-up" data-aos-delay="300">
                    <img src="http://static.photos/black/640x360/3" alt="Diggem Snapback" class="w-full h-64 object-cover">
                    <div class="p-6">
                        <h3 class="diggem-font text-2xl text-white mb-2">SNAPBACK CAP</h3>
                        <p class="text-gray-400 mb-4">Adjustable with embroidered logo</p>
                        <div class="flex justify-between items-center">
                            <span class="text-purple-400 font-bold text-xl">$24.99</span>
                            <a href="#" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-full text-sm font-bold transition">
                                BUY ON AMAZON
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Gaming Section -->
    <section id="gaming" class="py-20 bg-gray-900 bg-opacity-90">
        <div class="container mx-auto px-4">
            <h2 class="diggem-font text-4xl mb-12 text-center text-white" data-aos="fade-up">GAMING CONTENT</h2>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Video 1 -->
                <div class="bg-black rounded-lg overflow-hidden shadow-lg" data-aos="fade-up" data-aos-delay="100">
                    <div class="aspect-w-16 aspect-h-9">
                        <iframe class="w-full h-96" src="https://www.youtube.com/embed/dQw4w9WgXcQ" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                    </div>
                    <div class="p-6">
                        <h3 class="diggem-font text-2xl text-white mb-2">EPIC GAMING MOMENTS #1</h3>
                        <p class="text-gray-400">Check out these insane plays from last week's stream!</p>
                    </div>
                </div>
                
                <!-- Video 2 -->
                <div class="bg-black rounded-lg overflow-hidden shadow-lg" data-aos="fade-up" data-aos-delay="200">
                    <div class="aspect-w-16 aspect-h-9">
                        <iframe class="w-full h-96" src="https://www.youtube.com/embed/dQw4w9WgXcQ" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                    </div>
                    <div class="p-6">
                        <h3 class="diggem-font text-2xl text-white mb-2">NEW GAME REVIEW</h3>
                        <p class="text-gray-400">My honest thoughts on the latest release</p>
                    </div>
                </div>
            </div>
            <div class="text-center mt-12">
                <a href="#" class="inline-block bg-red-600 hover:bg-red-700 text-white px-8 py-3 rounded-full font-bold transition transform hover:scale-105">
                    SUBSCRIBE ON YOUTUBE
                </a>
            </div>
        </div>
    </section>

    <!-- Blog Section -->
    <section id="blog" class="py-20 bg-black bg-opacity-90">
        <div class="container mx-auto px-4">
            <h2 class="diggem-font text-4xl mb-12 text-center text-white" data-aos="fade-up">LATEST POSTS</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Post 1 -->
                <div class="bg-gray-900 rounded-lg overflow-hidden shadow-lg hover:shadow-purple-500/30 transition" data-aos="fade-up" data-aos-delay="100">
                    <img src="http://static.photos/technology/640x360/1" alt="Blog Post" class="w-full h-48 object-cover">
                    <div class="p-6">
                        <div class="flex items-center text-sm text-purple-400 mb-2">
                            <span>GAMING</span>
                            <span class="mx-2">•</span>
                            <span>3 DAYS AGO</span>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">My Gaming Setup 2023</h3>
                        <p class="text-gray-400 mb-4">Check out my upgraded battle station and gear recommendations for serious gamers.</p>
                        <a href="#" class="text-cyan-400 hover:text-cyan-300 font-bold flex items-center">
                            READ MORE <i data-feather="arrow-right" class="ml-2 w-4 h-4"></i>
                        </a>
                    </div>
                </div>
                
                <!-- Post 2 -->
                <div class="bg-gray-900 rounded-lg overflow-hidden shadow-lg hover:shadow-cyan-500/30 transition" data-aos="fade-up" data-aos-delay="200">
                    <img src="http://static.photos/technology/640x360/2" alt="Blog Post" class="w-full h-48 object-cover">
                    <div class="p-6">
                        <div class="flex items-center text-sm text-cyan-400 mb-2">
                            <span>STREETWEAR</span>
                            <span class="mx-2">•</span>
                            <span>1 WEEK AGO</span>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">New Drop Coming Soon</h3>
                        <p class="text-gray-400 mb-4">Sneak peek at our upcoming collection inspired by retro gaming aesthetics.</p>
                        <a href="#" class="text-purple-400 hover:text-purple-300 font-bold flex items-center">
                            READ MORE <i data-feather="arrow-right" class="ml-2 w-4 h-4"></i>
                        </a>
                    </div>
                </div>
                
                <!-- Post 3 -->
                <div class="bg-gray-900 rounded-lg overflow-hidden shadow-lg hover:shadow-purple-500/30 transition" data-aos="fade-up" data-aos-delay="300">
                    <img src="http://static.photos/technology/640x360/3" alt="Blog Post" class="w-full h-48 object-cover">
                    <div class="p-6">
                        <div class="flex items-center text-sm text-purple-400 mb-2">
                            <span>LIFESTYLE</span>
                            <span class="mx-2">•</span>
                            <span>2 WEEKS AGO</span>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">Balancing Gaming & Life</h3>
                        <p class="text-gray-400 mb-4">How I maintain productivity while keeping up with my gaming passion.</p>
                        <a href="#" class="text-cyan-400 hover:text-cyan-300 font-bold flex items-center">
                            READ MORE <i data-feather="arrow-right" class="ml-2 w-4 h-4"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- About/Contact Section -->
    <section id="about" class="py-20 bg-gray-900 bg-opacity-90">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <!-- About -->
                <div class="text-white" data-aos="fade-right">
                    <h2 class="diggem-font text-4xl mb-6">ABOUT DIGGEM</h2>
                    <p class="text-lg mb-6 text-gray-300">
                        Born from the fusion of streetwear culture and gaming passion, DIGGEM represents the lifestyle of the modern digital native. We create apparel that resonates with gamers and urban explorers alike.
                    </p>
                    <p class="text-lg mb-8 text-gray-300">
                        Founded in 2020, our mission is to bridge the gap between virtual worlds and street fashion, creating pieces that tell your story both online and offline.
                    </p>
                    <div class="flex space-x-6">
                        <a href="#" class="text-white hover:text-purple-400 transition">
                            <i data-feather="instagram" class="w-6 h-6"></i>
                        </a>
                        <a href="#" class="text-white hover:text-cyan-400 transition">
                            <i data-feather="twitter" class="w-6 h-6"></i>
                        </a>
                        <a href="#" class="text-white hover:text-red-400 transition">
                            <i data-feather="youtube" class="w-6 h-6"></i>
                        </a>
                        <a href="#" class="text-white hover:text-blue-400 transition">
                            <i data-feather="facebook" class="w-6 h-6"></i>
                        </a>
                    </div>
                </div>
                
                <!-- Contact Form -->
                <div class="bg-black bg-opacity-70 p-8 rounded-lg shadow-lg" data-aos="fade-left">
                    <h3 class="diggem-font text-2xl mb-6 text-white">GET IN TOUCH</h3>
                    <form>
                        <div class="mb-4">
                            <label for="name" class="block text-gray-300 mb-2">NAME</label>
                            <input type="text" id="name" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-purple-500">
                        </div>
                        <div class="mb-4">
                            <label for="email" class="block text-gray-300 mb-2">EMAIL</label>
                            <input type="email" id="email" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-cyan-500">
                        </div>
                        <div class="mb-6">
                            <label for="message" class="block text-gray-300 mb-2">MESSAGE</label>
                            <textarea id="message" rows="4" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-purple-500"></textarea>
                        </div>
                        <button type="submit" class="w-full bg-gradient-to-r from-purple-600 to-cyan-600 text-white px-6 py-3 rounded-full font-bold hover:from-purple-700 hover:to-cyan-700 transition">
                            SEND MESSAGE
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-black py-12 border-t border-gray-800">
        <div class="container mx-auto px-4">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <div class="mb-6 md:mb-0">
                    <a href="#" class="diggem-font text-2xl text-white">DIGGEM</a>
                    <p class="text-gray-500 mt-2">Streetwear • Gaming • Lifestyle</p>
                </div>
                <div class="flex flex-col md:flex-row md:space-x-8 space-y-4 md:space-y-0">
                    <a href="#" class="text-gray-400 hover:text-white transition">Privacy Policy</a>
                    <a href="#" class="text-gray-400 hover:text-white transition">Terms of Service</a>
                    <a href="#" class="text-gray-400 hover:text-white transition">Shipping Info</a>
                    <a href="#" class="text-gray-400 hover:text-white transition">FAQ</a>
                </div>
            </div>
            <div class="border-t border-gray-800 mt-8 pt-8 text-center text-gray-500">
                <p>© 2023 DIGGEM. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        // Initialize animations and effects
        AOS.init({
            duration: 800,
            easing: 'ease-in-out',
            once: true
        });
        
        feather.replace();
        
        // Vanta.js background
        VANTA.GLOBE({
            el: "#vanta-bg",
            mouseControls: true,
            touchControls: true,
            gyroControls: false,
            minHeight: 200.00,
            minWidth: 200.00,
            scale: 1.00,
            scaleMobile: 1.00,
            color: 0x9400d3,
            backgroundColor: 0x0,
            size: 0.8
        });
        
        // Mobile menu toggle
        document.querySelector('.md\\:hidden').addEventListener('click', function() {
            const menu = document.querySelector('.md\\:flex.space-x-8');
            menu.classList.toggle('hidden');
            menu.classList.toggle('flex');
            menu.classList.toggle('flex-col');
            menu.classList.toggle('absolute');
            menu.classList.toggle('top-16');
            menu.classList.toggle('right-4');
            menu.classList.toggle('bg-black');
            menu.classList.toggle('p-4');
            menu.classList.toggle('rounded-lg');
            menu.classList.toggle('space-y-4');
            menu.classList.toggle('space-x-0');
            menu.classList.toggle('shadow-lg');
        });
    </script>
</body>
</html>
